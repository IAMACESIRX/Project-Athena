{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-system.schemas.task.v1",
  "type": "object",
  "required": ["task_id", "title", "objective", "owner", "priority", "status"],
  "properties": {
    "task_id": { "type": "string" },
    "title": { "type": "string" },
    "objective": { "type": "string" },
    "owner": { "type": "string" },
    "project_id": { "type": "string" },
    "priority": { "enum": ["low", "normal", "high", "urgent"] },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["created", "assigned", "planning", "executing", "waiting", "review", "completed", "escalated", "failed", "archived"] },
    "deadline": { "type": "string" },
    "budget": { "type": "string" },
    "risk_score": { "type": "number" }
  }
}

