{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IAMACESIRX/Project-Athena/schemas/janus-skill-capsule.schema.json",
  "title": "JANUS Skill Capsule",
  "description": "Versioned, evidence-bearing, replayable application or OASIS workflow learned or authored for JANUS.",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "name", "version", "target", "intent_schema", "preconditions", "action_graph", "expected_state_diffs", "validation_probes", "permission_class", "status"],
  "properties": {
    "skill_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_type", "application_or_runtime"],
      "properties": {
        "environment_type": {"type": "string", "enum": ["desktop_application", "web_application", "mobile_application", "oasis_runtime", "device_interface", "other"]},
        "application_or_runtime": {"type": "string"},
        "compatible_versions": {"type": "array", "items": {"type": "string"}},
        "platforms": {"type": "array", "items": {"type": "string"}}
      }
    },
    "intent_schema": {"type": "object"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "action_graph": {"type": "object", "additionalProperties": true},
    "expected_state_diffs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "validation_probes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "rollback_plan": {"type": ["object", "null"], "additionalProperties": true},
    "permission_class": {"type": "string", "enum": ["O0_observe", "O1_prepare", "O2_reversible", "O3_consequential", "O4_privileged"]},
    "discovery_method": {"type": "string", "enum": ["human_authored", "human_demonstration", "application_cartography", "imported_adapter", "hybrid"]},
    "capability_hypothesis_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "owner": {"type": "string", "enum": ["human", "janus", "shared", "institutional"]},
    "privacy_class": {"type": "string", "enum": ["public", "internal", "private", "sensitive_local", "restricted"]},
    "status": {"type": "string", "enum": ["experimental", "verified", "deprecated", "blocked", "quarantined"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
