{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-system.schemas.fuzzy-claim.v1",
  "type": "object",
  "required": ["claim", "truth_value", "confidence", "evidence"],
  "properties": {
    "claim": { "type": "string" },
    "truth_value": {
      "enum": [
        "true",
        "false",
        "unknown",
        "partially_true",
        "likely_true",
        "likely_false",
        "contradicted",
        "stale",
        "not_applicable"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "caveats": { "type": "array", "items": { "type": "string" } },
    "retraction_condition": { "type": "string" },
    "safe_action": { "type": "string" }
  }
}
