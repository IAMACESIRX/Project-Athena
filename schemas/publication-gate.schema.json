{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-athena.schemas.publication_gate.v1",
  "type": "object",
  "required": [
    "schema",
    "canonical_policy",
    "default",
    "publication_requires_human_authorization",
    "local_only_paths",
    "required_review",
    "secret_patterns"
  ],
  "properties": {
    "schema": { "const": "project-athena.publication-gate.v1" },
    "canonical_policy": { "type": "string" },
    "default": { "const": "deny" },
    "publication_requires_human_authorization": { "const": true },
    "public_mirror": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "protected_surfaces": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "local_only_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "required_review": {
      "type": "object",
      "required": ["checklist_file", "checklist_heading"],
      "properties": {
        "checklist_file": { "type": "string" },
        "checklist_heading": { "type": "string" }
      },
      "additionalProperties": false
    },
    "secret_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "severity", "regex"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "severity": { "enum": ["error"] },
          "regex": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
