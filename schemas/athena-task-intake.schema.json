{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-system.schemas.athena_task_intake.v1",
  "title": "Athena Task Intake",
  "type": "object",
  "required": ["schema", "intake_id", "created_at", "human_goal", "active_layer", "priority_source", "required_output", "verification_method", "memory_writeback_targets"],
  "properties": {
    "schema": {"const": "ai-system.athena_task_intake.v1"},
    "intake_id": {"type": "string", "description": "Stable task-intake identifier."},
    "created_at": {"type": "string", "description": "ISO-8601 timestamp."},
    "human_goal": {"type": "string"},
    "execution_mode": {"enum": ["manual", "ai_assisted", "automated", "hybrid"], "default": "hybrid"},
    "active_layer": {"type": "string", "description": "Repository or subsystem currently being acted on."},
    "priority_source": {"type": "string", "description": "Highest authority for the task, for example Plan, governance, human instruction, or code."},
    "files_to_read": {"type": "array", "items": {"type": "string"}},
    "files_read": {"type": "array", "items": {"type": "string"}},
    "known_facts": {"type": "array", "items": {"$ref": "#/$defs/labeled_statement"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/labeled_statement"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/labeled_statement"}},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/labeled_statement"}},
    "benefits_to_preserve": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "weaknesses": {"type": "array", "items": {"$ref": "#/$defs/weakness"}},
    "mitigations": {"type": "array", "items": {"$ref": "#/$defs/mitigation"}},
    "interventions": {"type": "array", "items": {"$ref": "#/$defs/intervention"}},
    "required_output": {"type": "string"},
    "verification_method": {"type": "string"},
    "memory_writeback_targets": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "status": {"enum": ["created", "anchored", "planned", "executing", "paused", "verified", "complete", "blocked"]}
  },
  "$defs": {
    "labeled_statement": {
      "type": "object",
      "required": ["statement", "truth_value", "confidence"],
      "properties": {
        "statement": {"type": "string"},
        "truth_value": {"enum": ["observed", "verified", "inferred", "assumed", "unknown", "stale", "contradicted", "speculative", "not_applicable"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "string"}
      }
    },
    "weakness": {
      "type": "object",
      "required": ["weakness_id", "description", "harms", "associated_benefits", "disposition", "status"],
      "properties": {
        "weakness_id": {"type": "string"},
        "description": {"type": "string"},
        "triggers": {"type": "array", "items": {"type": "string"}},
        "harms": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "associated_benefits": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "disposition": {"enum": ["mitigate", "accept", "research", "remove_source", "monitor"]},
        "status": {"enum": ["open", "controlled", "accepted", "resolved", "superseded"]}
      }
    },
    "mitigation": {
      "type": "object",
      "required": ["mitigation_id", "weakness_ids", "control", "preserves_benefits", "activation_trigger", "execution_modes", "tradeoffs", "new_risks", "manual_verification", "machine_verification", "review_condition", "removal_condition", "status"],
      "properties": {
        "mitigation_id": {"type": "string"},
        "weakness_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "control": {"type": "string"},
        "preserves_benefits": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "activation_trigger": {"type": "string"},
        "execution_modes": {"type": "array", "items": {"enum": ["manual", "ai_assisted", "automated", "hybrid"]}, "minItems": 1},
        "tradeoffs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "new_risks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "manual_verification": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "machine_verification": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "review_condition": {"type": "string"},
        "removal_condition": {"type": "string"},
        "status": {"enum": ["proposed", "active", "testing", "effective", "ineffective", "revised", "retired"]}
      }
    },
    "intervention": {
      "type": "object",
      "required": ["intervention_id", "timestamp", "actor", "authority", "stage_id", "action", "reason", "changed_fields", "validation_required"],
      "properties": {
        "intervention_id": {"type": "string"},
        "timestamp": {"type": "string"},
        "actor": {"type": "string"},
        "authority": {"type": "string"},
        "stage_id": {"type": "string"},
        "action": {"enum": ["pause", "edit", "override", "branch", "reject", "resume", "rollback", "change_mode", "change_mitigation", "request_evidence", "request_review"]},
        "reason": {"type": "string"},
        "changed_fields": {"type": "array", "items": {"type": "string"}},
        "validation_required": {"type": "array", "items": {"type": "string"}},
        "rollback_or_branch": {"type": "string"}
      }
    }
  }
}
