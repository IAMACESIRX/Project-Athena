{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-system.schemas.athena-adapter.v1",
  "title": "Athena Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "class",
    "owner_layer",
    "surface",
    "capabilities",
    "scopes",
    "authority",
    "state_transfer",
    "failure"
  ],
  "properties": {
    "schema": { "const": "ai-system.athena_adapter.v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "class": {
      "enum": [
        "reader",
        "writer",
        "runtime",
        "model",
        "project_capsule",
        "learned_application"
      ]
    },
    "owner_layer": { "type": "string", "minLength": 1 },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "supported_versions"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "minLength": 1 },
        "provider": { "type": "string" },
        "supported_versions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "context_limit": { "type": "integer", "minimum": 1 },
        "modalities": { "$ref": "#/$defs/stringArray" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "unsupported"],
      "properties": {
        "declared": { "$ref": "#/$defs/stringArray" },
        "unsupported": { "$ref": "#/$defs/stringArray" },
        "probe": { "type": "string" }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": { "$ref": "#/$defs/stringArray" },
        "outputs": { "$ref": "#/$defs/stringArray" },
        "project_capsule_schema": { "type": "string" },
        "message_schema": { "type": "string" }
      }
    },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "network", "credentials", "runtime"],
      "properties": {
        "read": { "$ref": "#/$defs/stringArray" },
        "write": { "$ref": "#/$defs/stringArray" },
        "network": { "$ref": "#/$defs/stringArray" },
        "credentials": { "$ref": "#/$defs/stringArray" },
        "runtime": { "$ref": "#/$defs/stringArray" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ceiling", "confirmation_required"],
      "properties": {
        "ceiling": { "type": "integer", "minimum": 0, "maximum": 4 },
        "confirmation_required": { "$ref": "#/$defs/stringArray" },
        "human_presence_required": { "type": "boolean" }
      }
    },
    "state_transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dock", "undock", "handoff", "pending_write_policy"],
      "properties": {
        "dock": { "type": "string", "minLength": 1 },
        "undock": { "type": "string", "minLength": 1 },
        "handoff": { "type": "string", "minLength": 1 },
        "pending_write_policy": {
          "enum": ["commit", "abort", "transfer", "human_decision"]
        },
        "local_cache_is_authority": { "const": false }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idempotent": { "type": "boolean" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "rate_limit": { "type": "string" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detect", "contain", "rollback", "emergency_stop"],
      "properties": {
        "detect": { "type": "string", "minLength": 1 },
        "contain": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 },
        "emergency_stop": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/stringArray" },
        "audit_target": { "type": "string" },
        "secret_policy": { "type": "string" }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
